{
  "name": "frank-ditz-portfolio",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest run --passWithNoTests",
    "test:a11y": "start-server-and-test 'python3 -m http.server 4173 --directory dist --bind 127.0.0.1' http://127.0.0.1:4173 'playwright test'",
    "test:links": "start-server-and-test 'python3 -m http.server 4173 --directory dist --bind 127.0.0.1' http://127.0.0.1:4173 \"linkinator http://127.0.0.1:4173 --recurse --check-fragments --skip '^https://' --skip '^mailto:'\"",
    "verify": "pnpm format:check && pnpm lint && pnpm check && pnpm test && pnpm build && pnpm test:links && pnpm test:a11y"
  },
  "dependencies": {
    "@astrojs/react": "^7.0.0",
    "@astrojs/sitemap": "^3.7.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.3.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.63.0",
    "eslint": "10.11.0",
    "eslint-plugin-astro": "3.2.1",
    "linkinator": "^8.1.0",
    "prettier": "3.9.8",
    "prettier-plugin-astro": "1.0.1",
    "sharp": "0.35.4",
    "start-server-and-test": "^3.0.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.1"
  }
}
