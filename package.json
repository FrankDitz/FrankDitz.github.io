{
  "name": "frank-ditz-portfolio",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "generate:social-image": "node scripts/generate-social-image.mjs",
    "astro": "astro",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test:browser": "start-server-and-test 'python3 -m http.server 4173 --directory dist --bind 127.0.0.1' http://127.0.0.1:4173 'playwright test'",
    "test:links": "start-server-and-test 'python3 -m http.server 4173 --directory dist --bind 127.0.0.1' http://127.0.0.1:4173 \"linkinator http://127.0.0.1:4173 --recurse --check-fragments --skip '^https://' --skip '^mailto:'\"",
    "verify": "pnpm format:check && pnpm lint && pnpm check && pnpm build && pnpm test:links && pnpm test:browser"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.4"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.64.0",
    "eslint": "10.12.0",
    "eslint-plugin-astro": "3.2.1",
    "linkinator": "^8.1.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "sharp": "0.35.5",
    "start-server-and-test": "^3.0.13",
    "typescript": "7.0.2",
    "typescript-eslint": "8.71.1"
  }
}
