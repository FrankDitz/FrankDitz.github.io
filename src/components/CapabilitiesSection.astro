---
import { capabilities, engineeringPractices } from '../data/portfolio';
---

<section
  class="capabilities-section content-section"
  id="capabilities"
  aria-labelledby="capabilities-title"
>
  <div class="page-shell">
    <header class="content-section__heading content-section__heading--light">
      <p class="section-label">04 / Technical profile</p>
      <div>
        <h2 id="capabilities-title">Where I can contribute</h2>
        <p>
          A quick role-fit summary for backend, full-stack, platform, integration, and applied-AI
          teams—grounded in work I have already delivered.
        </p>
      </div>
    </header>

    <div class="capability-list">
      <div class="capability-list__labels" aria-hidden="true">
        <span>Area of contribution</span>
        <span>Evidence</span>
        <span>Working toolkit</span>
      </div>
      {capabilities.map((capability, index) => (
        <article class="capability-row">
          <div class="capability-row__focus">
            <span>0{index + 1}</span>
            <div>
              <h3>{capability.title}</h3>
              <p>{capability.description}</p>
            </div>
          </div>
          <p class="capability-row__evidence">
            <span>Evidence</span>
            {capability.evidence}
          </p>
          <ul aria-label={`${capability.title} technologies`}>
            {capability.technologies.map((technology) => (
              <li>{technology}</li>
            ))}
          </ul>
        </article>
      ))}
    </div>

    <div class="engineering-practices">
      <div>
        <p class="section-label">How I ship</p>
        <h3>Production-minded by default</h3>
      </div>
      <ul>
        {engineeringPractices.map((practice) => (
          <li>{practice}</li>
        ))}
      </ul>
    </div>
  </div>
</section>
