---
import { capabilities } from '../data/portfolio';
---

<section
  class="capabilities-section content-section"
  id="capabilities"
  aria-labelledby="capabilities-title"
>
  <div class="page-shell">
    <header class="content-section__heading content-section__heading--light">
      <p class="section-label">04 / Technical profile</p>
      <div>
        <h2 id="capabilities-title">Skills & capabilities</h2>
        <p>
          My strongest experience is in backend services, system integrations, cloud data workflows,
          and the delivery practices that keep them understandable and reliable.
        </p>
      </div>
    </header>

    <div class="capability-grid">
      {capabilities.map((capability, index) => (
        <article class="capability-card">
          <span>0{index + 1}</span>
          <h3>{capability.title}</h3>
          <p>{capability.description}</p>
          <ul>
            {capability.technologies.map((technology) => (
              <li>{technology}</li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>
