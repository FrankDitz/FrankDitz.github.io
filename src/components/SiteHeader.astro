---
const isHomePage = Astro.url.pathname === '/';
const isProjectsPage = Astro.url.pathname.startsWith('/projects');
const homePrefix = isHomePage ? '' : '/';
---

<header class="site-header page-shell" aria-label="Primary navigation">
  <a class="identity" href={`${homePrefix}#top`} aria-label="Frank Ditz, home">
    <span class="identity__mark" aria-hidden="true">
      FD
    </span>
    <span class="identity__copy">
      <strong>Frank Ditz</strong>
      <span>Software Engineer</span>
    </span>
  </a>

  <nav class="site-nav" aria-label="Main navigation">
    <a
      class:list={['site-nav__link', { 'site-nav__link--active': isHomePage }]}
      href={`${homePrefix}#top`}
    >
      Home
    </a>
    <a class="site-nav__link" href={`${homePrefix}#about`}>
      About
    </a>
    <a
      class:list={['site-nav__link', { 'site-nav__link--active': isProjectsPage }]}
      href="/projects/"
    >
      Projects
    </a>
    <a class="site-nav__link" href={`${homePrefix}#experience`}>
      Experience
    </a>
    <a class="site-nav__link" href={`${homePrefix}#capabilities`}>
      Skills
    </a>
    <a class="site-nav__link" href={`${homePrefix}#resume`}>
      Resume
    </a>
    <a class="site-nav__link" href={`${homePrefix}#contact`}>
      Contact
    </a>
  </nav>

  <p class="site-header__status">
    <span>Melbourne, FL</span>
  </p>
</header>
