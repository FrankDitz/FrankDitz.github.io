---
import { Image } from 'astro:assets';
import portrait from '../assets/frank-ditz-blue-suit.png';
---

<section class="hero page-shell" id="top" aria-labelledby="hero-title">
  <div class="hero__copy">
    <p class="eyebrow">
      <span></span> Full-stack / Integrations / Automation
    </p>
    <h1 id="hero-title">I turn complicated problems into dependable software.</h1>
    <p class="hero__intro">
      I’m Frank Ditz, a software engineer who builds full-stack applications, connects systems,
      automates manual work, and writes maintainable code that teams can rely on.
    </p>
    <div class="hero__actions" aria-label="Portfolio actions">
      <a class="button button--primary" href="#selected-work">
        Explore my work <span>→</span>
      </a>
      <a class="button button--secondary" href="#about">
        Read about me
      </a>
      <span class="button button--disabled" title="Résumé download coming soon">
        Résumé <small>soon</small>
      </span>
    </div>
  </div>

  <div class="hero__visual" aria-label="Portrait of Frank Ditz and independent project preview">
    <div class="hero__blue-field" aria-hidden="true"></div>
    <Image
      class="hero__portrait"
      src={portrait}
      alt="Frank Ditz wearing a blue suit"
      loading="eager"
      fetchpriority="high"
      quality={90}
    />

    <article class="project-preview" id="selected-work" aria-labelledby="project-preview-title">
      <p class="project-preview__label">Project 01 / Independent build / Planning</p>
      <div class="project-preview__window">
        <aside class="project-preview__sidebar" aria-label="Project preview navigation">
          <span class="project-preview__monogram">FD</span>
          <span class="is-active">Overview</span>
          <span>Research</span>
          <span>Build</span>
          <span>Test</span>
        </aside>
        <div class="project-preview__content">
          <div class="project-preview__heading">
            <div>
              <span>Selected work</span>
              <h2 id="project-preview-title">Project details coming soon</h2>
            </div>
            <span class="status-badge">Planning</span>
          </div>
          <div class="workflow" aria-hidden="true">
            <div>
              <span>01</span> Understand
            </div>
            <b>→</b>
            <div>
              <span>02</span> Build
            </div>
            <b>→</b>
            <div>
              <span>03</span> Refine
            </div>
          </div>
          <div class="project-preview__note">
            <span></span>
            <p>This area will become a real project interface, case study, and source link.</p>
          </div>
        </div>
      </div>
    </article>
  </div>
</section>
