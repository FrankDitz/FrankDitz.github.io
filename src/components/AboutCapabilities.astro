---
import { projectTracks } from '../data/portfolio';

const featuredDetails = [
  {
    icon: '?',
    title: 'Project standard',
    description:
      'Every featured project will start with a specific problem and a clearly defined user.',
  },
  {
    icon: '⚙',
    title: 'What it will show',
    description:
      'A working application, public source code, technical documentation, and a concise product walkthrough.',
  },
  {
    icon: '♢',
    title: 'Engineering depth',
    description:
      'Architecture, tradeoffs, testing strategy, reliability, and the decisions that shaped the implementation.',
  },
  {
    icon: '▱',
    title: 'Technology',
    description: 'Selected for the problem—not to maximize the number of technologies displayed.',
  },
  {
    icon: '○',
    title: 'Current status',
    description:
      'This slot remains a transparent placeholder until the repository and demo are ready.',
    status: true,
  },
];
---

<section class="portfolio-overview" aria-label="Portfolio overview">
  <div class="portfolio-overview__inner page-shell">
    <article class="about-panel" id="about" aria-labelledby="about-title">
      <p class="section-label">01 / Introduction</p>
      <h2 id="about-title">About me</h2>
      <div class="about-panel__bio">
        <p>
          I’m a software engineer based in Melbourne, Florida, focused on building reliable
          applications, APIs, and integrations that solve practical problems.
        </p>
        <p>
          My path into engineering began with data analytics and grew into enterprise software. At
          ALTR, I was promoted from field engineering intern to associate while working across
          Python, Node.js, AWS, PostgreSQL, Snowflake, data security, and applied AI.
        </p>
        <p>
          I do my best work where technical depth meets real users: understanding an ambiguous
          problem, designing a maintainable solution, and staying with it through testing, delivery,
          and troubleshooting.
        </p>
      </div>
      <a href="#experience">
        View experience <span>→</span>
      </a>
    </article>

    <article class="featured-panel" aria-labelledby="featured-title">
      <div class="featured-panel__heading">
        <div>
          <p class="section-label">02 / Independent work</p>
          <h2 id="featured-title">Featured projects</h2>
          <p>
            Reserved for a complete, public project with source code and a working demonstration.
          </p>
        </div>
        <div class="featured-panel__links" aria-label="Project links">
          <span>
            <b>◉</b>
            <i>
              GitHub<small>Coming soon</small>
            </i>
          </span>
          <span>
            <b>↗</b>
            <i>
              Live demo<small>Coming soon</small>
            </i>
          </span>
        </div>
      </div>

      <div class="featured-details">
        {featuredDetails.map((detail) => (
          <article class="featured-detail">
            <span class="featured-detail__icon">{detail.icon}</span>
            <div>
              <h3>{detail.title}</h3>
              {detail.status && (
                <p class="featured-detail__status">
                  <i></i> Planned
                </p>
              )}
              <p>{detail.description}</p>
            </div>
          </article>
        ))}
      </div>
    </article>
  </div>
</section>

<section class="project-library page-shell" id="projects" aria-labelledby="projects-title">
  <div class="project-library__heading">
    <div>
      <p class="section-label">03 / Independent work</p>
      <h2 id="projects-title">Projects</h2>
      <p>Public repositories and demonstrations will be organized into clear engineering tracks.</p>
    </div>
    <span class="project-library__status">Projects in development</span>
  </div>

  <div class="project-categories">
    {projectTracks.map(([icon, title, description]) => (
      <article class="project-category">
        <span>{icon}</span>
        <div>
          <h3>{title}</h3>
          <p>{description}</p>
        </div>
      </article>
    ))}
  </div>
</section>
