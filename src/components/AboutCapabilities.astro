---
const featuredDetails = [
  {
    icon: '?',
    title: 'The problem',
    description: 'Manual, fragmented processes created inconsistent data and wasted time.',
  },
  {
    icon: '⚙',
    title: 'What I built',
    description:
      'A full-stack web application that centralizes operations, integrates with external systems, and automates recurring workflows.',
  },
  {
    icon: '♢',
    title: 'Key decisions',
    description:
      'Chose a modular architecture, prioritized clean interfaces, used background processing for automation, and designed for maintainability.',
  },
  {
    icon: '▱',
    title: 'Technology',
    description: 'React, Node.js, PostgreSQL, third-party APIs, Docker (planned).',
  },
  {
    icon: '○',
    title: 'Current status',
    description: 'Actively building and expanding features.',
    status: true,
  },
];

const projectCategories = [
  ['▤', 'Workflow Automation', 'Tooling for file processing and API integrations.'],
  ['▱', 'Data Sync Utility', 'Synchronize and transform data across platforms.'],
  ['▥', 'Internal Tools', 'Small tools to simplify recurring tasks.'],
  ['</>', 'Open Source', 'Contributions and personal experiments.'],
  ['♙', 'Learning Projects', 'Prototypes and explorations.'],
];
---

<section class="portfolio-overview" id="experience" aria-label="Portfolio overview">
  <div class="portfolio-overview__inner page-shell">
    <article class="about-panel" id="about" aria-labelledby="about-title">
      <p class="section-label">01 / About</p>
      <h2 id="about-title">Hi, I’m Frank.</h2>
      <p>
        I’m a software engineer who enjoys building clean, maintainable applications that solve real
        problems. I work across the full stack—from user interfaces and APIs to integrations and
        automation—and I care about clear code, thoughtful systems, and steady progress.
      </p>
      <a href="#contact">
        More about me <span>→</span>
      </a>
    </article>

    <article class="featured-panel" aria-labelledby="featured-title">
      <div class="featured-panel__heading">
        <div>
          <p class="section-label">02 / Featured project</p>
          <h2 id="featured-title">Operations Platform</h2>
          <p>A full-stack application for workflow automation and system integration.</p>
        </div>
        <div class="featured-panel__links" aria-label="Project links">
          <span>
            <b>◉</b>
            <i>
              GitHub<small>Coming soon</small>
            </i>
          </span>
          <span>
            <b>↗</b>
            <i>
              Live demo<small>Coming soon</small>
            </i>
          </span>
        </div>
      </div>

      <div class="featured-details">
        {featuredDetails.map((detail) => (
          <article class="featured-detail">
            <span class="featured-detail__icon">{detail.icon}</span>
            <div>
              <h3>{detail.title}</h3>
              {detail.status && (
                <p class="featured-detail__status">
                  <i></i> In progress
                </p>
              )}
              <p>{detail.description}</p>
            </div>
          </article>
        ))}
      </div>
    </article>
  </div>
</section>

<section class="project-library page-shell" id="projects" aria-labelledby="projects-title">
  <div class="project-library__heading">
    <div>
      <p class="section-label">03 / Other projects</p>
      <h2 id="projects-title">More projects</h2>
      <p>A selection of other work, experiments, and tools.</p>
    </div>
    <a href="#projects">
      View all projects <span>→</span>
    </a>
  </div>

  <div class="project-categories">
    {projectCategories.map(([icon, title, description]) => (
      <article class="project-category">
        <span>{icon}</span>
        <div>
          <h3>{title}</h3>
          <p>{description}</p>
        </div>
      </article>
    ))}
  </div>
</section>

<span id="resume" class="anchor-target" aria-hidden="true"></span>
<span id="contact" class="anchor-target" aria-hidden="true"></span>
