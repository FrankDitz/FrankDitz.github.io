---
import { experience, professionalWork } from '../data/portfolio';
---

<section
  class="experience-section page-shell content-section"
  id="experience"
  aria-labelledby="experience-title"
>
  <header class="content-section__heading">
    <p class="section-label">04 / Professional background</p>
    <div>
      <h2 id="experience-title">Experience</h2>
      <p>
        My background combines software engineering, enterprise systems, and direct customer
        ownership—from understanding the problem through production troubleshooting.
      </p>
    </div>
  </header>

  <div class="experience-list">
    {experience.map((item) => (
      <article class="experience-item">
        <div class="experience-item__identity">
          <h3>{item.company}</h3>
          <p>{item.location}</p>
        </div>
        <div class="experience-item__body">
          <div class="experience-item__roles">
            {item.roles.map((role) => (
              <div>
                <h4>{role.title}</h4>
                <time>{role.dates}</time>
              </div>
            ))}
          </div>
          <p>{item.summary}</p>
          {item.highlights.length > 0 && (
            <ul>
              {item.highlights.map((highlight) => (
                <li>{highlight}</li>
              ))}
            </ul>
          )}
        </div>
      </article>
    ))}
  </div>

  <div class="professional-work" aria-labelledby="professional-work-title">
    <div class="professional-work__intro">
      <p class="section-label">Employer-owned work</p>
      <h3 id="professional-work-title">Selected professional work</h3>
      <p>
        These examples demonstrate scope and engineering judgment. The source belongs to my former
        employer, so code and live demos are intentionally not presented as public portfolio
        projects.
      </p>
    </div>
    <div class="professional-work__list">
      {professionalWork.map((item) => (
        <article class="work-example">
          <span>{item.number}</span>
          <div>
            <p>{item.context}</p>
            <h4>{item.title}</h4>
            <p>{item.description}</p>
            <ul aria-label={`${item.title} technologies`}>
              {item.skills.map((skill) => (
                <li>{skill}</li>
              ))}
            </ul>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
