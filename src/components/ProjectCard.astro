---
import type { PortfolioProject } from '../data/projects';

interface Props {
  project: PortfolioProject;
}

const { project } = Astro.props;
const demoLink = project.links.find((link) => link.kind === 'demo');
const sourceLink = project.links.find((link) => link.kind === 'source');
---

<article class="project-card">
  <div class="project-card__meta">
    <span>{project.number}</span>
    <span>{project.category}</span>
  </div>
  <h3>{project.title}</h3>
  <p>{project.summary}</p>
  <ul aria-label={`${project.title} technologies`}>
    {project.technologies.slice(0, 4).map((technology) => (
      <li>{technology}</li>
    ))}
  </ul>
  <div class="project-card__actions" aria-label={`${project.title} links`}>
    {demoLink ? (
      <a href={demoLink.href} target="_blank" rel="noreferrer">
        Live demo
      </a>
    ) : (
      <span aria-disabled="true">Live demo</span>
    )}
    {sourceLink ? (
      <a href={sourceLink.href} target="_blank" rel="noreferrer">
        GitHub
      </a>
    ) : (
      <span aria-disabled="true">GitHub</span>
    )}
    <a href={`/projects/${project.slug}/`}>Details</a>
  </div>
</article>
