---
import ProjectCard from './ProjectCard.astro';
import { projects } from '../data/projects';

const publishedProjects = projects.filter((project) => project.published);
const featuredProjects = publishedProjects
  .filter((project) => project.featured)
  .concat(publishedProjects.filter((project) => !project.featured))
  .slice(0, 3);
const emptyProjectSlots = Array.from({ length: 3 - featuredProjects.length });
---

<section class="portfolio-overview" aria-label="About and independent projects">
  <div class="portfolio-overview__inner page-shell">
    <article class="about-panel" id="about" aria-labelledby="about-title">
      <p class="section-label">01 / About</p>
      <h2 id="about-title">I build software around real operational problems.</h2>
      <div class="about-panel__bio">
        <p>
          I’m a software engineer in Melbourne, Florida. At ALTR, I progressed from field
          engineering intern to associate while delivering backend integrations, cloud workflows,
          and applied-AI tools for three enterprise customers.
        </p>
        <p>
          My work has included a typed Python SDK covering more than 100 API endpoints, a
          recoverable AWS-to-Snowflake data pipeline, and a governed AI assistant connected to
          enterprise data systems.
        </p>
        <p>
          Before engineering, I managed day-to-day operations for a medical practice. That
          experience still shapes how I work: clarify the actual constraint, communicate directly,
          and build systems people can depend on.
        </p>
      </div>
      <a href="#experience">
        See the supporting experience <span>→</span>
      </a>
    </article>

    <article class="featured-panel" id="projects" aria-labelledby="projects-title">
      <div class="featured-panel__heading">
        <div>
          <p class="section-label">02 / Independent projects</p>
          <h2 id="projects-title">Public work, shown with evidence</h2>
          <p>
            Three focused case studies with a working demo, public source code, and the engineering
            decisions behind each build.
          </p>
        </div>
      </div>

      <div class="project-card-grid">
        {featuredProjects.map((project) => (
          <ProjectCard project={project} />
        ))}
        {emptyProjectSlots.map((_, index) => {
          const slotNumber = featuredProjects.length + index + 1;

          return (
            <article class="project-card project-card--placeholder">
              <div class="project-card__meta">
                <span>0{slotNumber}</span>
                <span>In development</span>
              </div>
              <h3>Featured project {slotNumber}</h3>
              <p>
                Reserved for a completed public build with a working application, reviewable source
                code, and a concise engineering case study.
              </p>
              <p class="project-card__availability">
                Project details will be added when the build is ready.
              </p>
              <div
                class="project-card__actions"
                aria-label={`Featured project ${slotNumber} links`}
              >
                <span aria-disabled="true">Live demo</span>
                <span aria-disabled="true">GitHub</span>
                <span aria-disabled="true">Details</span>
              </div>
            </article>
          );
        })}
      </div>
    </article>
  </div>
</section>
